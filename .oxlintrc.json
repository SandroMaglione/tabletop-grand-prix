{
  "jsPlugins": [
    "@typeonce/oxlint-plugin-ritmo"
  ],
  "rules": {
    "ritmo/handle-runtime-result": "error",
    "ritmo/prefix-descriptor-and-system-names": "error",
    "ritmo/no-state-spread": "error",
    "ritmo/no-kept-query-values": "error"
  },
  "overrides": [
    {
      "files": [
        "src/sim/**"
      ],
      "rules": {
        "ritmo/use-clock-for-time": "error",
        "ritmo/use-random-for-randomness": "error",
        "ritmo/use-ops-for-math": "error",
        "ritmo/keep-simulation-headless": "error",
        "ritmo/no-infinity-in-simulation-data": "error",
        "ritmo/no-float-timers": "error",
        "ritmo/no-brand-cast": "error",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../host/*",
                  "**/host/**"
                ],
                "message": "The simulation never imports page code: the page reads the race through the simulation's inspector and gives it input."
              },
              {
                "group": [
                  "**/api/**",
                  "**/server/**"
                ],
                "message": "The simulation knows nothing of the leaderboard: the server and the page import the simulation, never the other way."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/host/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/sim/*",
                  "!**/sim/index.ts"
                ],
                "message": "The page reads the simulation only through src/sim/index.ts: its session, its replays and the track queries it draws with."
              },
              {
                "group": [
                  "**/server/**"
                ],
                "message": "The page talks to the server only through the Leaderboard service in src/api."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/api/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/host/**",
                  "**/server/**"
                ],
                "message": "src/api is what the page and the server share: it imports neither."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/server/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/host/**"
                ],
                "message": "The server never imports page code: it shares src/api and the simulation with it."
              }
            ]
          }
        ]
      }
    }
  ]
}
