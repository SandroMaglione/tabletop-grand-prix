{
  "jsPlugins": [
    "@typeonce/oxlint-plugin-ritmo"
  ],
  "rules": {
    "ritmo/handle-runtime-result": "error",
    "ritmo/prefix-descriptor-and-system-names": "error",
    "ritmo/no-state-spread": "error"
  },
  "overrides": [
    {
      "files": [
        "src/sim/**"
      ],
      "rules": {
        "ritmo/use-clock-for-time": "error",
        "ritmo/use-random-for-randomness": "error",
        "ritmo/use-ops-for-math": "error",
        "ritmo/keep-simulation-headless": "error",
        "ritmo/no-infinity-in-simulation-data": "error",
        "ritmo/no-float-timers": "error",
        "ritmo/no-brand-cast": "error",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../host/*",
                  "**/host/**"
                ],
                "message": "The simulation never imports page code: the page reads the match through the simulation's inspector and sends intents."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/host/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/sim/*",
                  "!**/sim/index.ts"
                ],
                "message": "The page reads the simulation only through src/sim/index.ts: its runtime, inspector, intents and the rule helpers it draws with."
              }
            ]
          }
        ]
      }
    }
  ]
}
